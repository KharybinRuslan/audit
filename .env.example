# Публичный URL сайта без завершающего слеша (canonical, Open Graph, sitemap.xml, robots.txt).
# На продакшене https://auditte.ru задайте в окружении веб-сервера или скопируйте в .env и подгрузите сами.
# AUD_SITE_URL=https://auditte.ru
# Опционально: JSON-LD sameAs (профили в соцсетях), URL через запятую.
# AUD_SCHEMA_SAME_AS=https://t.me/example,https://vk.com/example

# --- Форма «Запрос на аудит» (audit-request-submit.php) ---
# Куда доставлять заявки (по умолчанию info@auditte.ru).
# AUD_MAIL_TO=info@auditte.ru
# От кого видит сервер исходящей почты (лучше тот же ящик или отдельный @auditte.ru на Mail.ru).
# Ответ клиенту в почте — по Reply-To с адреса из формы, не по этому полю.
# AUD_MAIL_FROM_EMAIL=info@auditte.ru
# AUD_MAIL_FROM_NAME=Заявка с сайта auditte.ru
#
# У вас MX на emx.mail.ru и SPF с include:_spf.mail.ru — почта домена на Mail.ru (часто так подключают к Bitrix24).
# Тогда на Beget в .env задайте SMTP Mail.ru (пароль — обычный от ящика или «Пароль для внешнего приложения» в id.mail.ru):
# AUD_SMTP_HOST=smtp.mail.ru
# AUD_SMTP_PORT=465
# AUD_SMTP_ENCRYPTION=ssl
# AUD_SMTP_USER=info@auditte.ru
# AUD_SMTP_PASSWORD=
#
# Альтернатива: порт 587 и AUD_SMTP_ENCRYPTION=tls
#
# Если AUD_SMTP_HOST не задан — отправка через PHP mail() на стороне Beget (SPF у вас уже включает beget.com).

# Google reCAPTCHA v2 (чекбокс). Если заданы оба ключа — виджет на форме и проверка на сервере.
# Ключи: https://www.google.com/recaptcha/admin — домен auditte.ru, тип v2 «Я не робот».
# AUD_RECAPTCHA_SITE_KEY=
# AUD_RECAPTCHA_SECRET_KEY=
